DATABASE_URL=postgres://ehr_user:YOUR_PASSWORD@localhost:5432/ehr_db?sslmode=disable
JWT_SECRET=YOUR_RANDOM_SECRET

# Optional. Database for `go test ./...` (a throwaway schema is created inside
# it; your data is never touched). Defaults to DATABASE_URL.
# TEST_DATABASE_URL=postgres://ehr_user:YOUR_PASSWORD@localhost:5432/ehr_db?sslmode=disable

# Optional. No clearinghouse adapter is bundled; leaving this unset keeps
# electronic claim submission disabled (CLEARINGHOUSE_NOT_CONFIGURED).
# CLEARINGHOUSE_PROVIDER=
